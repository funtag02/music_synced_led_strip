    {
        "id": "b0285e4101466a1d",
        "type": "function",
        "z": "8fd7435e4ab2710a",
        "name": "Data separation",
        "func": "const instruments = [\"Snare\", \"Clap\", \"HiHat\", \"Kick\"];\nconst result = {\nSnare: 0,\nClap: 0,\nHiHat: 0,\nKick: 0\n};\n\n// Expression régulière pour extraire chaque instrument avec sa probabilité\nconst regex = /(\\bSnare\\b|\\bClap\\b|\\bHiHat\\b|\\bKick\\b)\\s*\\(([\\d.]+)\\)/g;\nlet match;\nwhile ((match = regex.exec(msg.payload)) !== null) {\n    const [_, name, value] = match;\n    result[name] = parseFloat(value);\n}\n\n// Crée un message par sortie (Snare = sortie 1, Clap = sortie 2, etc.)\nconst msgSnare = { payload: result.Snare };\nconst msgClap = { payload: result.Clap };\nconst msgHiHat = { payload: result.HiHat };\nconst msgKick = { payload: result.Kick };\n\n// Retourne les 4 messages vers les 4 sorties respectives\nreturn [msgSnare, msgClap, msgHiHat, msgKick];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
